{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go fmt:*)",
      "Bash(go mod tidy)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl diff:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl config current-context)",
      "Bash(helm template:*)",
      "Bash(helm lint:*)",
      "Bash(aws sts get-caller-identity)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(python3 ~/.claude/skills/worklog/scripts/vault.py:*)",
      "Read(/Users/pedrobarreiro/Documents/Workbench/**)",
      "Edit(/Users/pedrobarreiro/Documents/Workbench/**)",
      "Write(/Users/pedrobarreiro/Documents/Workbench/**)",
      "Read(**/.env.example)",
      "Edit(**/.env.example)",
      "Bash(scripts/ub *)",
      "Bash(scripts/q scripts/ub *)"
    ],
    "deny": [
      "Bash(terraform destroy:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(kubectl get secret:*)",
      "Bash(kubectl get secrets:*)",
      "Bash(kubectl describe secret:*)",
      "Read(**/.env)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      // "EnterPlanMode",
      // "ExitPlanMode",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList",
      "RemoteTrigger",
      "PushNotification",
      "SendMessage",
      "NotebookEdit",
      "DesignSync",
      "ReportFindings"
    ],
    "ask": [
      "Bash(terraform apply:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl rollout:*)",
      "Bash(kubectl exec:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/trim-noisy-output.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "disableRemoteControl": true,
  "disableArtifact": true
}
